{
  "expo": {
    "name": "Voice Expense",
    "slug": "voice-expense-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "voiceexpenseapp",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.voiceexpense.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F766E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "The microphone is used to hear your voice command. Audio is never saved.",
          "speechRecognitionPermission": "Speech recognition turns your voice command into text, on your phone when possible.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      "expo-secure-store",
      "./plugins/withRecordShortcut",
      [
        "expo-notifications",
        {
          "color": "#0F766E"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 33,
            "kotlinVersion": "2.4.0"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
