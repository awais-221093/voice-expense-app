{
  "name": "voice-expense-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.29",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^27.1.1",
    "@react-native-firebase/auth": "^27.1.1",
    "@react-native-firebase/firestore": "^27.1.1",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-speech-recognition": "^58.0.1",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc -p scripts",
    "eval": "tsx scripts/llm-eval/run.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "start:dev": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "android:device": "expo run:android --device",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:clean": "expo prebuild --platform android --clean",
    "gradle:clean": "cd android && gradlew clean",
    "gradle:stop": "cd android && gradlew --stop",
    "gradle:release": "cd android && gradlew assembleRelease",
    "adb:reverse": "adb reverse tcp:8081 tcp:8081",
    "doctor": "npx expo-doctor",
    "check": "npm run typecheck && npm run lint",
    "firebase:deploy": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "private": true
}
